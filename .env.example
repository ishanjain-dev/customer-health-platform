# Every variable the platform reads, with no values (spec sections 6 and 14.1).
# Copy to .env for local development; .env is git-ignored. In CI these come from
# GitHub Environment secrets (qa, prod, prod-run). Never commit real values.

# --- Salesforce: integration user, JWT bearer flow (External Client App CHP_Pipeline) ---
SF_CLIENT_ID=
SF_JWT_PRIVATE_KEY=
SF_USERNAME=
SF_LOGIN_URL=

# --- Salesforce: sf CLI deploys and scratch orgs ---
SF_DEPLOY_AUTH_URL=
DEVHUB_AUTH_URL=

# --- Snowflake (30-day window only), key-pair auth per service user ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_LOADER_KEY=
SNOWFLAKE_DBT_KEY=
SNOWFLAKE_RETL_KEY=

# --- MotherDuck (steady state) ---
MOTHERDUCK_TOKEN=

# Non-secret runtime settings (environment, warehouse target, paths) are added here
# when chp.config is built.
